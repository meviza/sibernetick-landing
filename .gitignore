# Dependencies
node_modules/
.pnpm-store/

# Cloudflare Wrangler
.wrangler/
.dev.vars
.mf/

# Environment
.env
.env.*
!.env.example

# Build output
dist/
build/
out/
_next/
.cache/
*.tsbuildinfo

# Public build artifacts (generated by `npm run build` → scripts/build.mjs).
# The public/ directory itself is committed empty; everything inside it is
# build output and must not be committed.
/public/**
!/public/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

